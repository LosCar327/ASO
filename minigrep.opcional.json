            ],
            "rc": 0
        },
        {
            "cmt": "-n -o: combinada; con coincidencia vacía no se muestra ni el número",
            "cmd": [
                "/usr/bin/echo -e -n 'axx\\nxxa\\nb\\n' | LD_PRELOAD=./libasosysintercept.so.0.1 ./minigrep -n -o -r 'x*'"
            ],
            "out": "2:xx\n",
            "rc": 0
        },
        {
            "cmt": "-n -o: combinada, 64 Ki líneas y buffers de 64 B",
            "cmd": [
                "python3 genera_lineas.py -b 1048576 -l 16 | LD_PRELOAD=./libasosysintercept.so.0.1 ./minigrep -n -o -r '[[:digit:]]a{3,}[[:alpha:]]+' -s 64"
            ],
