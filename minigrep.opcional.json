{
    "setup": {
        "desc": "minigrep (ampliaciones optativas -n y -o)",
        "timeout": 3,
        "cmds": [],
        "binaries": [
            "libasosysintercept.so.0.1",
            "minigrep",
            "genera_lineas.py"
        ]
    },
    "tests": [
        {
            "cmt": "-n: básico (se cuentan también las líneas no mostradas)",
            "cmd": [
                "/usr/bin/echo -e -n '1234\\n5678\\n90AB\\n' | LD_PRELOAD=./libasosysintercept.so.0.1 ./minigrep -r '67' -n"
            ],
            "out": "2:5678\n",
            "rc": 0
        },
        {
            "cmt": "-n: con -v (se numeran también las líneas no mostradas)",
            "cmd": [
                "/usr/bin/echo -e -n '1234\\n5678\\n90AB\\n' | LD_PRELOAD=./libasosysintercept.so.0.1 ./minigrep -r '67' -v -n"
            ],
            "out": [
                "1:1234\n",
                "3:90AB\n"
            ],
            "rc": 0
        },
        {
            "cmt": "-n: paso de 9 a 10, de 99 a 100 y ceros intermedios",
            "cmd": [
                "seq 1 1000 | LD_PRELOAD=./libasosysintercept.so.0.1 ./minigrep -r '^(9|10|99|100|909|1000)$' -n"
            ],
            "out": [
                "9:9\n",
                "10:10\n",
                "99:99\n",
                "100:100\n",
                "909:909\n",
                "1000:1000\n"
            ],
            "rc": 0
        },
        {
            "cmt": "-n: números de 5 cifras (64 Ki líneas)",
            "cmd": [
                "python3 genera_lineas.py -b 1048576 -l 16 | LD_PRELOAD=./libasosysintercept.so.0.1 ./minigrep -r 'aaaa' -n"
            ],
            "out": [
                "12233:0aaaa3dc5b5e34b\n",
                "21128:5021de0800aaaab\n",
                "26881:e638ace4aaaa084\n",
                "42436:4fd21ac82aaaabc\n",
                "42510:6d9aaaa113e7b07\n",
                "43593:aaaaaff0a3b0648\n",
                "50071:d5daaaae85b299e\n",
                "51734:6baaaa6c9ecedcc\n",
                "57673:d3a925c2635aaaa\n"
            ],
            "rc": 0
        },
        {
            "cmt": "-n: escrituras parciales de 1 B y buffers de tamaño 3",
            "cmd": [
                "export ASOSYSINT_WRITE__MAX_BLOCK_SIZE=1",
                "python3 genera_lineas.py -b 1048576 -l 16 | LD_PRELOAD=./libasosysintercept.so.0.1 ./minigrep -r 'aaaa' -n -s 3"
            ],
            "out": [
                "12233:0aaaa3dc5b5e34b\n",
                "21128:5021de0800aaaab\n",
                "26881:e638ace4aaaa084\n",
                "42436:4fd21ac82aaaabc\n",
                "42510:6d9aaaa113e7b07\n",
                "43593:aaaaaff0a3b0648\n",
                "50071:d5daaaae85b299e\n",
                "51734:6baaaa6c9ecedcc\n",
                "57673:d3a925c2635aaaa\n"
            ],
            "rc": 0
        },
        {
            "cmt": "-o: coincidencia al principio, al final y en medio; solo la primera de cada línea",
            "cmd": [
                "/usr/bin/echo -e -n '12ab34\\nab34\\nx5y6\\nabc\\n' | LD_PRELOAD=./libasosysintercept.so.0.1 ./minigrep -o -r '[[:digit:]]+'"
            ],
            "out": [
                "12\n",
                "34\n",
                "5\n"
            ],
            "rc": 0
        },
        {
            "cmt": "-o: coincidencia vacía (no se muestra nada para esa línea)",
            "cmd": [
                "/usr/bin/echo -e -n 'axx\\nxxa\\nb\\n' | LD_PRELOAD=./libasosysintercept.so.0.1 ./minigrep -o -r 'x*'"
            ],
            "out": "xx\n",
            "rc": 0
        },
        {
            "cmt": "-o: con -v es un error",
            "cmd": [
                "/usr/bin/echo -e -n '1234\\n5678\\n90AB\\n' | LD_PRELOAD=./libasosysintercept.so.0.1 ./minigrep -r '67' -o -v"
            ],
            "out": "ERROR: Las opciones -o y -v son incompatibles\n",
            "rc": 1
        },
        {
            "cmt": "-o: con -v, el error de BUFSIZE tiene prioridad",
            "cmd": [
                "/usr/bin/echo -e -n '1234\\n5678\\n90AB\\n' | LD_PRELOAD=./libasosysintercept.so.0.1 ./minigrep -o -v -r '67' -s 0"
            ],
            "out": "ERROR: BUFSIZE debe ser mayor que 0 y menor que o igual a 1 MB\n",
            "rc": 1
        },
        {
            "cmt": "-o: escrituras parciales de 1 B y buffers de tamaño 3",
            "cmd": [
                "export ASOSYSINT_WRITE__MAX_BLOCK_SIZE=1",
                "python3 genera_lineas.py -b 1048576 -l 16 | LD_PRELOAD=./libasosysintercept.so.0.1 ./minigrep -s 3 -o -r '[[:digit:]]a{3,}[[:alpha:]]+'"
            ],
            "out": [
